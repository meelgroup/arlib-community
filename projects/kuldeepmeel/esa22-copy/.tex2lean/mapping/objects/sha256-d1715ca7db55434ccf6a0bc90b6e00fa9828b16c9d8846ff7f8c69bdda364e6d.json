      "kind": "headline",
      "summary": "Claim cl:loop: in Algorithm 3, each a ∈ S_j is in Y_{k,j} independently with probability 2^{-k}",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
