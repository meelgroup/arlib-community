      "id": "obligation:0ee748fc-15af-4ce4-88c4-938ab70a4a8e",
      "kind": "headline",
      "summary": "Claim lm:fail: Pr[Fail] ≤ δ/8 via Pr[Fail_j] ≤ 2^{−thresh} and the union bound over j ≤ m",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
