      "claimId": "claim:52d1b3b5-9fd4-48a3-be13-b6755db985e6",
      "targetVersionId": "target-version:323bbbaf-d7f0-4120-930c-9331b3c1bc9f",
      "anchor": {
        "file": "main.tex",
        "excerptDigest": "sha256-e3bfe5f48fc5c74379db040d813e9db7d270cef4efe7b8f1e0523370da264b70"
      },
      "text": "If L = 0 the TV distance is computed deterministically and exactly (Sparsify is never called).",
