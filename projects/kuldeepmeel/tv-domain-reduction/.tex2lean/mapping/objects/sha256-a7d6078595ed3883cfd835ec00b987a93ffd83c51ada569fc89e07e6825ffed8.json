          "excerptDigest": "sha256-4c05dfc6b7511de02623398a249d4f2926b516522b3e6faabb095f6b0ca5bd57"
        }
      ],
      "status": "active"
    },
    {
      "id": "claim-version:80152eef-ad56-412c-a649-6fa3b4e8ac9b",
      "claimId": "claim:a900ba37-a4e0-4f57-8f0d-66d3bf41576b",
      "targetVersionId": "target-version:5bf98b5b-cfef-47a7-b239-c471a3076520",
      "anchor": {
        "file": "main.tex",
        "excerptDigest": "sha256-618ea67fc7296fe21bd392a72ee91ad2fff62332c05f270fc0ce80ffe2242455"
      },
      "text": "Each retained coreset has at most m = Theta(k log k / delta^2 log(1/eta')) rows.",
      "normalizedTextDigest": "sha256-2df9b2b6cc7c62651165b3edd520656500594f50009302721d87ccabe8dc321b",
      "kind": "space",
      "evidence": [
