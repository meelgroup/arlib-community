  "obligations": [
    {
      "id": "obligation:6ad3fe16-e3f2-4a13-b567-7b1ca74888bc",
      "kind": "headline",
      "summary": "(1 - epsilon) d_TV(P,Q) <= D~ <= (1 + epsilon) d_TV(P,Q) with probability at least 1 - eta.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:cbc1124f-b647-4ec3-af2b-0b341dd38daa",
      "kind": "headline",
      "summary": "The algorithm runs in time polynomial in n, k, 1/epsilon, log(1/eta) and max_t |Omega_t|.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:bda9856f-219d-4c35-87ec-b09087f3a16a",
      "kind": "implementation",
      "summary": "Per-step: with probability at least 1 - eta', (1 - delta) E(U_t, y) <= E(C_t, y) <= (1 + delta) E(U_t, y) simultaneously for all y in R^k.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Program.",
      "owner": "Model/Program",
      "status": "planned"
    },
    {
      "id": "obligation:30143039-22b8-47ac-aab6-3275d7fdc774",
      "kind": "headline",
      "summary": "Conditioned on Sparsify succeeding at step t, (1 - delta) F_{t-1} <= F_t <= (1 + delta) F_{t-1}.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:7863906d-a4a7-4ce7-ba60-da7a2acf89c3",
      "kind": "headline",
      "summary": "Union bound: all n steps succeed with probability at least 1 - n eta' = 1 - eta.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:2e6daa3d-aa87-44f8-9779-fc9b3800c9e3",
      "kind": "headline",
      "summary": "Telescoping and calibration: (1 - delta)^n F_0 <= F_n <= (1 + delta)^n F_0 and, at delta = epsilon/(3n), (1 + epsilon/3n)^n <= e^{epsilon/3} <= 1 + epsilon and (1 - epsilon/3n)^n >= 1 - epsilon.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:a75219a4-8df3-4e3a-a543-fb28c3701249",
      "kind": "headline",
      "summary": "F_0 = d_TV(P,Q) and F_n = D~.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:b5c235d4-3ccc-41c1-b296-a5c6daeb20e0",
      "kind": "implementation",
      "summary": "Each retained coreset has at most m = Theta(k log k / delta^2 log(1/eta')) rows.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Program.",
      "owner": "Model/Program",
      "status": "planned"
    },
    {
      "id": "obligation:e7cc235d-8363-4081-9b00-470093ccdcd8",
      "kind": "headline",
      "summary": "Per-step arithmetic cost O~((|Omega_t| m) k + k^omega) = O~(|Omega_t| n^2 k^2 eps^{-2} log(n/eta) + k^omega).",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    },
    {
      "id": "obligation:8294a42d-c42e-4f8f-8557-d4fa4d06a745",
      "kind": "headline",
      "summary": "Sparsify's own guarantee: at most m = O(d log d / delta^2 log(1/eta)) nonzeros, a (1 +- delta) ell_1 embedding with probability >= 1 - eta, in O~(Nd + d^omega) arithmetic operations for delta in (0,1/2) and omega <= 2.4.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:08dbe6ff-3960-407e-842f-b11a6571b2bf",
      "kind": "headline",
      "summary": "<w, R(x)> = P(x) - Q(x) and d_TV(P,Q) = (1/2) sum_x |<w, R(x)>|.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    }
  ],
