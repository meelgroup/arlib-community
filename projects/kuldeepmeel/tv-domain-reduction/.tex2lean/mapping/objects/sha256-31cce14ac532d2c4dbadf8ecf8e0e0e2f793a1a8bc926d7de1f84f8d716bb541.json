  "obligations": [
    {
      "id": "obligation:ae54664e-3e68-4c25-ba09-7bb9c6a76ed9",
      "kind": "headline",
      "summary": "With probability at least 1−η, (1−ε) d_TV(P,Q) ≤ d̂ ≤ (1+ε) d_TV(P,Q)",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:9e18c0aa-c29c-4b39-a12b-f40eb5dfdf08",
      "kind": "headline",
      "summary": "The run performs Õ(|V| d² (q + d + d²|V|²/ε² log(|V|/η))² + |V| d^{2ω}) arithmetic operations (Lean: d³ in place of d² in the first term with Program.build unchanged)",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:6b78bdb6-2e95-4342-899b-f040fbf89df4",
      "kind": "headline",
      "summary": "⟨a_TV, Φ_r(x)⟩ = P(x) − Q(x) pointwise, hence d_TV(P,Q) = ½ E(D_r, a_TV)",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:c8791708-ad5c-49d2-98c3-3248ee772f45",
      "kind": "headline",
      "summary": "The bottom-up DP computes Z_R: m_u^R = Σ_{x_{S_u}} h_u^R(x_{S_u}), m_r^R = Z_R",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:af8366f0-aeb1-471a-868f-18671b556aa4",
      "kind": "headline",
      "summary": "The two-layer scalar subcircuit computes the bilinear gate, i.e. the expanded circuit computes h_u^R",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    },
    {
      "id": "obligation:95f74a7b-5929-4567-8b17-da5c78454470",
      "kind": "headline",
      "summary": "Zero-padding does not change either induced distribution",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    },
    {
      "id": "obligation:06ef642d-8ef4-44cc-b205-44f65a5ac107",
      "kind": "headline",
      "summary": "The expanded circuits are smooth, decomposable and structured w.r.t. the same v-tree",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    },
    {
      "id": "obligation:c9fde7dd-c6ba-44c4-a40f-f9fcafbc755a",
      "kind": "headline",
      "summary": "All I sparsification steps succeed simultaneously with probability ≥ 1 − I·η' = 1 − η (inherited from thm:pc_fpras)",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:7327c775-6d81-4c14-9eed-f90c9a660d3c",
      "kind": "headline",
      "summary": "W ≤ d² + d + 1, L = I ≤ |V|, |C| = O(|L|d + I d³)",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:3bb175c4-ac3d-4fc2-89fe-720c242466d3",
      "kind": "implementation",
      "summary": "The normalization DP costs O(|L| q d + I d³) and is subsumed by the bound",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Program.",
      "owner": "Model/Program",
      "status": "planned"
    },
    {
      "id": "obligation:5e084c5f-d1f7-487d-af3c-1230facfe8ae",
      "kind": "headline",
      "summary": "M = O(W L² log(2W)/ε² log(L/η)) retained rows per internal-region coreset, substituted into the time bound",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:3edc9410-8c53-4d7c-8a6a-10874aaa8c17",
      "kind": "headline",
      "summary": "If I = 0 the TV distance is computed exactly by enumeration",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    }
  ],
