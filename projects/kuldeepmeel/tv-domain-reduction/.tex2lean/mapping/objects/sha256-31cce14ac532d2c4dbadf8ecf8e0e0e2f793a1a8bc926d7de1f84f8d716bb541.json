    {
      "id": "claim-version:d7482709-e490-456e-b8d9-f3182d410a72",
      "claimId": "claim:69f8b4c1-6144-49d4-a8ed-21f0ea8513fd",
      "targetVersionId": "target-version:60435ee7-a6be-4457-92ca-87578f18b5a2",
      "anchor": {
        "file": "main.tex",
        "from": 997,
        "to": 998,
        "excerptDigest": "sha256-23d7bcc0c366f31ae1193a85eedc49c22a8cec43e8f363b4665269cb599cf0e0"
      },
      "text": "With probability at least 1−η, (1−ε) d_TV(P,Q) ≤ d̂ ≤ (1+ε) d_TV(P,Q)",
      "normalizedTextDigest": "sha256-e6b74589ca983476d3aefb122af01b48ef5d3ad3f46c9a96fd7995735cae453a",
      "kind": "probability",
      "evidence": [
        {
