        }
      ],
      "status": "active"
    },
    {
      "id": "claim-version:2a411bec-4733-400a-b9f2-5c056b15cd08",
      "claimId": "claim:5721bed3-39eb-4bc0-beed-17d8073038ed",
      "targetVersionId": "target-version:60435ee7-a6be-4457-92ca-87578f18b5a2",
      "anchor": {
