  "obligations": [
    {
      "id": "obligation:b06ae9b9-aab5-4087-870e-075aefdabdbd",
      "kind": "headline",
      "summary": "(1−ε) d_TV(P,Q) ≤ D̃ ≤ (1+ε) d_TV(P,Q) with probability at least 1−η.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:e209a09f-8a49-4ad7-b0c4-d420fb599eeb",
      "kind": "headline",
      "summary": "Conditionally on all L sparsifications succeeding, the root coreset reproduces the exact root functional to within (1±δ)^L, and more generally the invariant holds at every constructed region with exponent ℓ(S), for all queries a simultaneously.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:e7129c62-a994-4b3d-863b-34fadf555ec7",
      "kind": "headline",
      "summary": "Sum gates/layers introduce no error and no domain expansion (a fixed linear reparametrisation of features preserves every linear test).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:a500336a-aa68-4e58-95d3-b1fc99eff3f6",
      "kind": "headline",
      "summary": "The exact root sum ∑_x |⟨a_TV, Φ_root(x)⟩| equals 2 d_TV(P,Q), and the root coreset sum equals 2D̃.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:533953b5-12d7-4858-9b02-3914a1932762",
      "kind": "headline",
      "summary": "All L sparsification steps succeed with probability at least 1 − Lη' = 1 − η (union bound over the L product-region steps).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:a71f6167-fc13-49fc-a8d6-a185c1836b1a",
      "kind": "headline",
      "summary": "Each sparsification call retains at most m = O(W log(2W)/δ² log(1/η')) rows; hence M = O(W L² log(2W)/ε² · log(L/η)).",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:abec8d81-8e51-4651-acf3-f130579c07b4",
      "kind": "headline",
      "summary": "Every binary product region has at most (q+M)² candidate rows (children are leaves with ≤ q rows or internal with ≤ M rows).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:4b73c0ce-ff7e-4531-b632-5d1adee8335f",
      "kind": "headline",
      "summary": "The product-stage feature matrix has O(W) columns, so the Lewis weights of one region cost Õ((q+M)²W + W^ω) arithmetic operations.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:15151909-44dc-4227-a6f1-41c4259cdb84",
      "kind": "headline",
      "summary": "Evaluating the exact leaf tables of both circuits costs O(q|C|); applying all subsequent gates and wires to surviving rows only costs O(M|C|).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:2f4ddf94-850d-4081-88d7-1e4618a4e7ca",
      "kind": "headline",
      "summary": "Total arithmetic running time Õ((q+M)|C| + L[W(q+M)² + W^ω]).",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:6f38db73-ea93-4d1b-a980-e385c4917ee3",
      "kind": "headline",
      "summary": "If L = 0 the TV distance is computed deterministically and exactly (Sparsify is never called).",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    },
    {
      "id": "obligation:3670c95c-ebb0-4279-866b-c9fd9c109f54",
      "kind": "headline",
      "summary": "Theorem thm:lewis_weights: a randomized algorithm outputs a nonnegative diagonal Y with ≤ O(d log d/δ² log(1/η)) nonzeros which is a (1±δ) ℓ_1 subspace embedding with probability ≥ 1−η, computed in Õ(Nd + d^ω) arithmetic operations.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    }
  ],
