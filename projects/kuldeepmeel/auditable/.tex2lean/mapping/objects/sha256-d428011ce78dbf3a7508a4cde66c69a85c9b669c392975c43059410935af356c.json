  "obligations": [
    {
      "id": "obligation:8eb8474b-ae76-4da3-af5f-45319111687e",
      "kind": "headline",
      "summary": "(S) Soundness: CountAuditor F K = verified → |sol F|/4 ≤ 2^(c_high/k) ≤ 16|sol F|, for every certificate K and n ≥ 12",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:1904748e-7825-4a9e-b1f2-668569bc1ce2",
      "kind": "headline",
      "summary": "(C) Completeness: |sol F| ≥ 1 → CountAuditor F (AFCounter F) = verified",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:7db54c3c-5203-45dd-a227-55a5c2f5aa39",
      "kind": "headline",
      "summary": "(T) CountAuditor makes exactly one oracle call, a forall-exists query answered by a Sigma_2^P oracle",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:9ee59332-a3b3-4560-be26-e2b3b065e298",
      "kind": "headline",
      "summary": "(R) The query on AFCounter F has O(n log n) variables (paper: O(|α|+|z|) = O(n')), concretely ≤ 4n·ceil(log2 n)",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:12bc59ad-1006-446e-9220-50e49a8cc5a1",
      "kind": "headline",
      "summary": "(R-exact) Pi2Query.size (auditQuery F K) = (K.chigh + 2) * n' + K.clow for every K",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:be0fc867-aa10-4aec-b4fc-a69744751cb6",
      "kind": "headline",
      "summary": "eq:imp: holesWith F' c_low hs ∧ stockWith F' c_high hs' → 2^c_low/(c_low+1) ≤ |sol F'| ≤ c_high·2^c_high",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:287a6089-83dc-4c9d-b19e-7cde94cdda84",
      "kind": "headline",
      "summary": "lem:holes: holesWith G m hs → 2^m ≤ (m+1)·|sol G|",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:f890eae4-fff1-4a5e-86ec-60f7effecc69",
      "kind": "headline",
      "summary": "cl:stockup: stockWith G m hs → |sol G| ≤ m·2^m (true for isolation semantics; FALSE for stockPairwiseWith)",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:b7f24e03-b240-4e71-b986-145e2c0a7bc8",
      "kind": "headline",
      "summary": "lm:holesexist: |sol G| ≥ 2^(m+3) → holes G m (pairwise-independent family)",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:732416ad-b280-4d19-a3dd-ae2feef4d530",
      "kind": "headline",
      "summary": "lm:stockexist: 1 ≤ m, |sol G| ≤ 2^(m-2) → stock G m",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:c36499bd-e321-4f1c-8eb6-b09a52ebaf50",
      "kind": "headline",
      "summary": "Gap lemma: on the honest run with |sol F| ≥ 1, c_high ≤ c_low + 7",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:67528b64-6058-4e2e-bdb2-68ed03171019",
      "kind": "headline",
      "summary": "|sol (makeCopies F k)| = |sol F|^k",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:8b8b33d2-75db-4adf-8dd2-a19a8482d6b3",
      "kind": "headline",
      "summary": "Honest run: c_low ≤ n', 1 ≤ c_high ≤ n', and the returned hash tuples are valid witnesses",
      "rationale": "The finalized blueprint assigns this paper claim to Interface.",
      "owner": "Interface",
      "status": "planned"
    },
    {
      "id": "obligation:808890b4-2909-4a95-a34b-102fbe416a59",
      "kind": "headline",
      "summary": "The paper's (R) is incompatible with (S) under any single reading of φ_stock (see ambiguityLedger); the final check must compare the formalized size bound against O(n log n) and report it",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    }
  ],
