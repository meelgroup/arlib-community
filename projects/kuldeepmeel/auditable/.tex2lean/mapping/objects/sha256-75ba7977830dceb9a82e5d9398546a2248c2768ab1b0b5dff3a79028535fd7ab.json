  "obligations": [
    {
      "id": "obligation:ae3b65a3-dc4d-4e1b-b152-08832fa42156",
      "kind": "headline",
      "summary": "Stock makes at most n' = n * Nat.clog 2 n calls to the Sigma_2^P oracle: (stockCounter F).cost Op.stockQuery <= nPrime n, for every n and F",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:60be24e4-87f5-4488-be0f-57b51036c57e",
      "kind": "headline",
      "summary": "Stock makes no other oracle call: (stockCounter F).cost Op.holesQuery = 0 and (stockCounter F).cost Op.sigma2Query = 0",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:28d1af48-abca-4edb-a3b6-35273046bdbe",
      "kind": "headline",
      "summary": "DAC: for 4 <= n and 1 <= |sol F|, |sol F|/16 <= estimate (copies n) (stockCounter F).val.v <= 16 |sol F|",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:8edb0b3a-5cb7-449a-be6a-822bec63457e",
      "kind": "implementation",
      "summary": "Stock is a charged, deterministic program whose single loop is AFCounter's stock loop: first success over List.range' 1 n', default (0, empty)",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Program.",
      "owner": "Model/Program",
      "status": "planned"
    },
    {
      "id": "obligation:b6767f75-bdd3-4bcb-b021-50f3da0295ba",
      "kind": "headline",
      "summary": "v = first m in [1, n'] with exists hs, stockWith F' m hs (pseudocode: (stockResult (fPrime F)).1 when n' >= 1); hstock witnesses stockWith F' v",
      "rationale": "The finalized blueprint assigns this paper claim to Interface.",
      "owner": "Interface",
      "status": "planned"
    },
    {
      "id": "obligation:3217a30b-8a5a-41da-9357-36afebeb70c7",
      "kind": "headline",
      "summary": "Reachability: for n' >= 1 some m in [1, n'] succeeds (identity hashes at m = n'), so 1 <= v <= n' and the default is not taken",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:a4dc785b-eb99-4bd3-9c3c-17ce230e0872",
      "kind": "headline",
      "summary": "Minimality: for 1 <= m < v, not exists hs, stockWith F' m hs",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:6b456f61-5bdc-4c6f-83bd-444a46eb3997",
      "kind": "headline",
      "summary": "cl:stockup: stockWith G m hs -> solCount G <= m * 2^m (injection z ↦ (i, h_i(z)))",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:4945c311-9fba-42b9-a34f-2e1c0ef3f985",
      "kind": "headline",
      "summary": "lm:stockexist: 4 * solCount G <= 2^m -> exists hs : Fin m -> AffHash N m, stockWith G m hs (real-valued reading of |sol| <= 2^(m-2))",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:5ebf0e0c-55d6-405e-8714-59a3592471d0",
      "kind": "headline",
      "summary": "solCount (makeCopies F k) = solCount F ^ k",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:061fde0e-786a-4e9e-af0b-9d4a631eec17",
      "kind": "headline",
      "summary": "2^(v-3) <= |sol F'| <= v 2^v and the k-th-root step to the factor 16 for n >= 4",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:5dca163a-568b-490b-ac68-4f255ee28fb3",
      "kind": "headline",
      "summary": "Report: DAC false for unsatisfiable F; literal break placement makes the theorem false; call count assumes unit-cost witness-returning oracles; 16 and n >= 4 are not in the statement",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    }
  ],
