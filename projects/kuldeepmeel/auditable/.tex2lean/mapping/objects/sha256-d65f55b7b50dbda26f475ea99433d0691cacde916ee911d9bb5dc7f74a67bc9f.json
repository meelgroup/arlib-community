  "claimVersions": [
    {
      "id": "claim-version:0dad6de6-e4af-4090-98c7-146245d734bc",
      "claimId": "claim:6c71a258-9d38-4766-b35b-b621ffed9416",
      "targetVersionId": "target-version:2e120744-dc04-42ae-8a96-90f426edd456",
