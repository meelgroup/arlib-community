/-
Machine-checks the audit surface: the statement of the headline theorem must
unfold only to constants defined under `ArlibCommunity.Algorithms.CV18/Model/`.

This is tooling, hence proof content, hence deliberately *outside* the surface
it checks.

Seeding from a theorem's **type** rather than its value is the crux: the proof
may use anything, and routinely should. Only the statement is constrained.
-/
import Lean

open Lean Elab Command

namespace ArlibCommunity.Algorithms.CV18.Meta

/-- Which module defines a constant.

    `getModuleIdxFor?` is the only route in current Lean: `getModuleFor?` was
    removed, and an index has to be looked up in the header's module table. A
    constant with no index is not imported at all — it belongs to the module
    being elaborated right now. -/
private def moduleOf (env : Environment) (c : Name) : Name :=
  match env.getModuleIdxFor? c with
  | some idx => (env.allImportedModuleNames[idx.toNat]?).getD `«unknown»
  | none => env.mainModule

/-- All constants defined in this package's modules that are reachable from a
seed, through both types and values.

Membership is decided by the *defining module*, not by the name: vendored
background files declare constants in foreign namespaces such as
`ArlibCommunity.Foundations`, and a name-prefix test would silently miss them. -/
private partial def closureAux (env : Environment) :
    NameSet → List Name → NameSet → NameSet
  | _, [], acc => acc
  | seen, c :: rest, acc =>
    if seen.contains c then closureAux env seen rest acc
    else
      let seen := seen.insert c
      let acc := if (`ArlibCommunity).isPrefixOf (moduleOf env c) then acc.insert c else acc
      match env.find? c with
      | none => closureAux env seen rest acc
      | some ci =>
        let next := ci.type.getUsedConstants.toList
          ++ (match ci.value? with | some v => v.getUsedConstants.toList | none => [])
        closureAux env seen (next ++ rest) acc

/-- Package constants not defined under `ArlibCommunity.Algorithms.CV18/Model/`, paired with the module defining them. -/
private def outsideModel (env : Environment) (cls : NameSet) : List (Name × Name) :=
  cls.toList.filterMap fun c =>
    let mod := moduleOf env c
    if (`ArlibCommunity.Algorithms.CV18.Model).isPrefixOf mod then none else some (c, mod)

/-- Seeded from a definition's own body — use this on the algorithm. -/
elab "#modelClosure " id:ident : command => do
  let env ← getEnv
  let n ← liftCoreM <| Lean.realizeGlobalConstNoOverload id
  let cls := (closureAux env {} [n] {}).erase n
  match outsideModel env cls with
  | [] => logInfo m!"OK — closure of {n} is defined entirely under Model/ ({cls.toList.length})"
  | bad => throwError m!"OUTSIDE Model/ in closure of {n}: {bad}"

/-- Seeded from a theorem's *type*, so the statement — not the proof — unfolds. -/
elab "#modelClosureOfType " id:ident : command => do
  let env ← getEnv
  let some ci := env.find? (← liftCoreM <| Lean.realizeGlobalConstNoOverload id)
    | throwError "unknown constant"
  let cls := closureAux env {} ci.type.getUsedConstants.toList {}
  match outsideModel env cls with
  | [] => logInfo m!"OK — the STATEMENT is defined entirely under Model/ ({cls.toList.length})"
  | bad => throwError m!"OUTSIDE Model/ in the statement: {bad}"

/-- Names the elaborator generates for every declaration, which nobody wrote and which
therefore cannot be moved out of `Model/`. -/
private def autoGenerated : List String :=
  ["noConfusion", "noConfusionType", "casesOn", "recOn", "rec", "brecOn", "below",
   "ndrec", "injEq", "inj", "sizeOf_spec", "mk", "toCtorIdx", "ofNat", "eq_def",
   "elim", "ctorIdx", "ctorElim", "ctorElimType", "ofNat_ctorIdx", "eq_1", "repr",
   "default", "binductionOn", "induct", "mutual_induct"]

private def isAutoGenerated (c : Name) : Bool :=
  -- `inst` can appear at any depth, and the elaborator numbers its match and
  -- equation auxiliaries, so neither test can look only at the last component
  c.components.any (fun p => match p with
    | .str _ s => "inst".isPrefixOf s || "match_".isPrefixOf s || "eq_".isPrefixOf s ||
        "proof_".isPrefixOf s || "_".isPrefixOf s
    | _ => false)
  || (match c.componentsRev.headD .anonymous with
      | .str _ s => autoGenerated.contains s
      | _ => false)

/-- **A module holds exactly what its claims are about, and nothing else.**

`#surplusIn M from s₁ … sₙ` reports every author-written constant *defined* in a module
under `M` that the seeds do not reach.  A seed that is a theorem contributes its
statement; a seed that is a definition contributes itself.

The closure checks say nothing in a statement escapes `Model/`.  This says nothing in a
module escapes its own claims, and the pair together pin the audited surface from both
sides.  Without it a module only ever grows: a definition parked there for convenience
is indistinguishable, to a reader, from one the claims depend on.

Run it twice, with different seeds: once on `Model/` from the headline theorem, once on
`Model/Program.lean` from the algorithm's entry point.

**Instances defined in the module are seeds too**: an instance is part of how the module
is written, not something parked in it.

Surplus is a **warning**, not a build error: whether a surplus definition should move or
the claims should mention it is a judgment.  What is not a judgment is knowing which
ones they are. -/
elab "#surplusIn " mod:ident " from " ids:ident+ : command => do
  let env ← getEnv
  let prefix_ := mod.getId
  let mut seeds : List Name := []
  let mut named : List Name := []
  for id in ids do
    let n ← liftCoreM <| Lean.realizeGlobalConstNoOverload id
    let some ci := env.find? n | throwError "unknown constant {n}"
    named := n :: named
    -- a theorem contributes its statement; a definition contributes itself
    let isP ← liftTermElabM (Lean.Meta.isProp ci.type)
    seeds := seeds ++ (if isP then ci.type.getUsedConstants.toList else [n])
  for (c, _) in env.constants.toList do
    if c.isInternal then continue
    unless prefix_.isPrefixOf (moduleOf env c) do continue
    if ← liftTermElabM (Lean.Meta.isInstance c) then seeds := seeds ++ [c]
  -- a seed is reached by itself: a theorem does not appear in its own statement
  let mut keep := closureAux env {} seeds {}
  -- a reached inductive type reaches its constructors, and through them the types of
  -- its fields (`VolumeInput` reaches `unitBall` through `unitBall_subset`)
  let ctors := keep.toList.foldl (fun acc c =>
    match env.find? c with
    | some (.inductInfo ii) => acc ++ ii.ctors
    | _ => acc) []
  keep := closureAux env {} (seeds ++ ctors) {}
  for n in named do keep := keep.insert n
  let mut surplus : Array Name := #[]
  for (c, _) in env.constants.toList do
    if c.isInternal || isAutoGenerated c then continue
    unless prefix_.isPrefixOf (moduleOf env c) do continue
    if keep.contains c then continue
    -- a field of a structure the claims reach is part of that structure
    if let some pi := env.getProjectionFnInfo? c then
      if keep.contains pi.ctorName.getPrefix then continue
    surplus := surplus.push c
  if surplus.isEmpty then
    logInfo m!"OK — every author-written constant under {prefix_} is reached by its \
      claims ({keep.toList.length} reached)."
  else
    logWarning m!"SURPLUS in {prefix_} — defined there, reached by none of its claims, \
      so it widens the audited surface without widening the claim: {surplus.toList}"

end ArlibCommunity.Algorithms.CV18.Meta
